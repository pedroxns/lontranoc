# OtterPilot — /etc/otterpilot/.env (formato dotenv)
# Tokens do Proxmox não ficam aqui: /etc/otterpilot/credentials/proxmox_token_{id,secret}

## MQTT ##
MQTT_HOST=
MQTT_PORT=1883

## OpenObserve (histórico) ##
OPENOBSERVE_URL=
OPENOBSERVE_ORG=default
OPENOBSERVE_INGEST_USER=
OPENOBSERVE_INGEST_TOKEN=
OPENOBSERVE_READ_USER=
OPENOBSERVE_READ_TOKEN=

## Home Assistant ##
HA_URL=
HA_TOKEN=
#HA_TOKEN_VEHICLE=
#UPS_STATUS_ENTITY=sensor.dnb_status
#UPS_BATTERY_ENTITY=sensor.dnb_carga_da_bateria
#RACK_TEMP_ENTITY=sensor.clima_servidor_temperature

## Ollama ##
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

## AdGuard (n = 1, 2, ...) ##
ADGUARD1_NAME=
ADGUARD1_HOST=
ADGUARD1_PORT=80
ADGUARD1_HTTPS=false
ADGUARD1_USER=
ADGUARD1_PASS=

## Frigate ##
FRIGATE_URL=

## Estado (opcional) ##
#OTTERPILOT_STATE_DB=/var/lib/otterpilot/state.db
