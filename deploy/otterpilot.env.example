# OtterPilot — /etc/otterpilot/.env (formato dotenv)
#
# Tudo aqui também pode ser configurado pela interface web
# (Integrações > Configurar). Campos vazios ficam desativados.

## Broker MQTT ##
MQTT_HOST=
MQTT_PORT=1883
#MQTT_USERNAME=
#MQTT_PASSWORD=

## OpenObserve (histórico, opcional) ##
#OPENOBSERVE_URL=
#OPENOBSERVE_ORG=default
#OPENOBSERVE_INGEST_USER=
#OPENOBSERVE_INGEST_TOKEN=
#OPENOBSERVE_READ_USER=
#OPENOBSERVE_READ_TOKEN=

## Home Assistant ##
#HA_URL=
#HA_TOKEN=
#UPS_STATUS_ENTITY=
#UPS_BATTERY_ENTITY=
#RACK_TEMP_ENTITY=
#HA_TOKEN_VEHICLE=

## Proxmox VE ##
# O token também pode vir de /etc/otterpilot/credentials/proxmox_token_{id,secret}.
#PROXMOX_URL=
#PROXMOX_VERIFY_SSL=true
#PROXMOX_TOKEN_ID=
#PROXMOX_TOKEN_SECRET=

## Ollama / Copilot ##
#OLLAMA_URL=
#OLLAMA_MODEL=qwen3.5:9b

## AdGuard Home (n = 1, 2, 3) ##
#ADGUARD1_NAME=
#ADGUARD1_HOST=
#ADGUARD1_PORT=80
#ADGUARD1_HTTPS=false
#ADGUARD1_USER=
#ADGUARD1_PASS=

## Frigate ##
#FRIGATE_URL=
#FRIGATE_MQTT_PREFIX=frigate

## Zigbee2MQTT ##
#ZIGBEE2MQTT_BASE_TOPICS=zigbee2mqtt

## Interface web ##
#OTTERPILOT_API_HOST=0.0.0.0
#OTTERPILOT_API_PORT=8470
