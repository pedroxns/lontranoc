[Unit]
Description=OtterPilot Polling Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=otterpilot
Group=otterpilot
WorkingDirectory=/var/lib/otterpilot
Environment=OTTERPILOT_ROOT=/etc/otterpilot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/otterpilot/venv/bin/python -m otterpilot.core.scheduler
LoadCredential=proxmox_token_id:/etc/otterpilot/credentials/proxmox_token_id
LoadCredential=proxmox_token_secret:/etc/otterpilot/credentials/proxmox_token_secret
StateDirectory=otterpilot
StateDirectoryMode=0750
Restart=always
RestartSec=10

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
